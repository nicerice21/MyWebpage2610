---
import { contacts } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="note">© {year} 〇〇 — built with Astro on Cloudflare.</p>
    <ul class="footer-links">
      {
        contacts.map((contact) => (
          <li>
            <a href={contact.url} rel="external noopener">
              {contact.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
